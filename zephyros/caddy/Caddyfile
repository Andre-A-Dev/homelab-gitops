# Zephyros – Caddy Reverse Proxy
# - pihole.home, pihole-zephyros.home -> local Pi-hole web UI (host port 8081)
# - pihole-boreas.home -> Boreas Pi-hole via Mnemosyne's Caddy
# - fritz-zephyros.home -> local FritzBox UI
# - all other .home domains -> Mnemosyne's Caddy via Tailscale (100.x.x.x)
#
# Port 80 belongs to Caddy (Pi-hole moved to 8081), so the automatic
# HTTP -> HTTPS redirect is active for every site.
# After relocation: replace 100.x.x.x with Mnemosyne's local IP (one place).

# -- Snippet: proxy to Mnemosyne ------------------------------------------
# Usage: import mnemosyne <hostname>
# Sets Host header and TLS SNI so Mnemosyne's Caddy picks the right site/cert.

(mnemosyne) {
    tls internal
    reverse_proxy https://100.x.x.x {
        header_up Host {args[0]}
        transport http {
            # Mnemosyne uses its own internal CA; tunnel is encrypted by Tailscale
            tls_insecure_skip_verify
            tls_server_name {args[0]}
            versions 1.1
        }
    }
}

# -- Snippet: read-only proxy to Mnemosyne --------------------------------
# Usage: import mnemosyne_readonly <hostname>
# For sites without their own login. Mnemosyne trusts Zephyros' Tailscale IP
# like the home LAN, so every remote LAN client would get write access:
# Prometheus' lifecycle API (POST /-/quit) and Alertmanager silences.
# Only GET and HEAD pass; reading (UI, Room Climate plasmoid) keeps working.

(mnemosyne_readonly) {
    @write not method GET HEAD
    respond @write "Read-only via Zephyros" 403
    import mnemosyne {args[0]}
}

# -- Pihole ---------------------------------------------------------------

pihole.home, pihole-zephyros.home {
    tls internal
    redir / /admin/ 301
    reverse_proxy http://host.docker.internal:8081
}

# Boreas (home network) Pi-hole, routed through Mnemosyne's Caddy
pihole-boreas.home {
    import mnemosyne pihole-boreas.home
}

# -- FritzBox -------------------------------------------------------------
# Local FritzBox UI. FRITZ!OS rejects unknown Host headers (DNS rebind
# protection, 400), so send its IP instead.

fritz-zephyros.home {
    tls internal
    reverse_proxy http://192.168.1.x {
        header_up Host {upstream_hostport}
    }
}

