# Container user — must own ./data (check on the host: id -u; id -g)
PUID=1000
PGID=1000

# PrusaLink (printer touchscreen: Settings -> Network -> PrusaLink)
PRUSA_HOST=192.168.1.x
PRUSA_USERNAME=maker
PRUSA_PASSWORD=<prusalink-password>

# Shelly Plug M Gen3 that powers the printer
PLUG_HOST=192.168.1.x

# BLU H&T in the enclosure, relayed by blu_gateway.js into this gateway's KVS
CLIMATE_GATEWAY_HOST=192.168.1.x
CLIMATE_SENSOR_MAC=xx:xx:xx:xx:xx:xx
CLIMATE_STALE_AFTER_S=600

# Power stays on while the nozzle is hotter than this (heatbreak cooling)
INTERLOCK_NOZZLE_MAX_C=50

# Shared with Caddy, which injects it as X-Galatea-Token. Generate: openssl rand -hex 32
GALATEA_API_TOKEN=<random-hex>

HTTP_TIMEOUT_S=5
STATUS_CACHE_TTL_S=2
