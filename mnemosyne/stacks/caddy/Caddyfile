# -- Galatea ----------------------------------------------------------------------

galatea.home {
    tls internal

    basic_auth {
        {$GALATEA_BASIC_USER} {$GALATEA_BASIC_HASH}
    }

    reverse_proxy galatea:8000 {
        header_up -Authorization
        header_up X-Galatea-Token {env.GALATEA_API_TOKEN}
    }
}