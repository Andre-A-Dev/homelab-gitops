# -- Pi-hole ---------------------------------------------------------------
# pihole.home is site-local: each network's DNS points it at its own Pi-hole.
# Home network: Boreas. The suffixed names reach a specific instance from
# either site (Zephyros proxies pihole-boreas.home here).

pihole.home, pihole-boreas.home {
    tls internal
    redir / /admin/ 301
    reverse_proxy http://192.168.1.11:80
}

# Plain HTTP over Tailscale; the tunnel is encrypted
pihole-zephyros.home {
    tls internal
    redir / /admin/ 301
    reverse_proxy http://100.y.y.y:8081
}

# -- FritzBox (Zephyros) ---------------------------------------------------
# Both LANs use the same subnet, so the remote box is not routable from here.
# Hand the request to Zephyros' Caddy, which proxies it to the box.

fritz-zephyros.home {
    tls internal
    reverse_proxy https://100.y.y.y {
        header_up Host fritz-zephyros.home
        transport http {
            tls_insecure_skip_verify
            tls_server_name fritz-zephyros.home
            versions 1.1
        }
    }
}

