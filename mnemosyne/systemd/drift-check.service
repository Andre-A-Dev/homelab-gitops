[Unit]
Description=Drift check - Git vs. running Docker state (report only)
Documentation=file:///home/<user>/homelab-infra/mnemosyne/scripts/drift_check.py
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=<user>
# Healthchecks.io ping UUIDs for Mnemosyne jobs (root:root 600, not in Git)
EnvironmentFile=/etc/homelab/healthchecks.env
# Without a UUID the check would run unobserved - refuse instead.
# $$ passes a literal $ to sh instead of letting systemd expand it.
ExecStartPre=/bin/sh -c 'test -n "$$HC_DRIFT"'
ExecStart=/usr/bin/python3 /home/<user>/homelab-infra/mnemosyne/scripts/drift_check.py
# Exit 1 = drift found: a finding, reported via Healthchecks - not a broken
# unit. Exit 2 (check error) still marks the unit failed.
SuccessExitStatus=1
